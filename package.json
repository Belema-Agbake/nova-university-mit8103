{
  "name": "nova-university",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:db": "tsx --test tests/database/*.test.ts",
    "test:db:isolated": "tsx scripts/run-isolated-db-tests.ts",
    "firebase:emulator": "npx -y firebase-tools@latest emulators:start --only auth",
    "auth:seed": "cross-env FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx tests/auth/emulator-seed.ts",
    "test:auth": "cross-env FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 firebase emulators:exec --only auth \"npm run auth:seed && tsx --test tests/auth/*.test.ts\"",
    "test:firestore": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 firebase emulators:exec --only firestore \"tsx --test tests/firestore/*.test.ts\"",
    "test:outbox": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/run-isolated-outbox-tests.ts",
    "test:outbox:emulator": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 firebase emulators:exec --only firestore \"tsx --test tests/outbox/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:roles": "tsx scripts/run-authenticated-e2e-tests.ts",
    "test:e2e:roles:emulator": "cross-env FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 NEXT_PUBLIC_USE_FIREBASE_AUTH_EMULATOR=true firebase emulators:exec --only auth \"npm run auth:seed && playwright test tests/e2e/authenticated-roles.spec.ts\"",
    "benchmark:transactions": "tsx portfolios/portfolio-3-transactions-concurrency/run.ts",
    "benchmark:sql": "tsx scripts/benchmark-sql.ts",
    "benchmark:sql:seed": "tsx portfolios/portfolio-2-sql-optimisation/seed-large-dataset.ts",
    "verify:schema:readonly": "tsx scripts/verify-production-schema.ts",
    "provision:belema:local": "cross-env FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx scripts/provision-belema-local.ts",
    "provision:belema:catalogue": "tsx scripts/provision-belema-catalogue.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
